import os
import glob
import re
import numpy as np
import pandas as pd
from collections import Counter

BASE = "/kaggle/input/competitions/3rd-wear-dataset-challenge-hasca-2026"
TRAIN_DIR = os.path.join(BASE, "train", "inertial_feat")

SENSOR_COLS = [
    "right_arm_acc_x", "right_arm_acc_y", "right_arm_acc_z",
    "right_leg_acc_x", "right_leg_acc_y", "right_leg_acc_z",
    "left_leg_acc_x", "left_leg_acc_y", "left_leg_acc_z",
    "left_arm_acc_x", "left_arm_acc_y", "left_arm_acc_z"
]

WINDOW_SIZE = 50
STRIDE = 50  # Non-overlapping windows for a manageable baseline

X_train_raw, y_train_raw = [], []
X_val_raw, y_val_raw = [], []

train_files = sorted(glob.glob(os.path.join(TRAIN_DIR, "*.csv")))

def participant_id(path):
    match = re.search(r"sbj_(\d+)", os.path.basename(path))
    return int(match.group(1))

def make_windows(df):
    X, y = [], []

    # Treat each contiguous run of the same valid label separately.
    labels = df["label"].astype("string")
    valid = labels.notna() & labels.str.strip().ne("")

    start = 0
    while start < len(df):
        if not valid.iloc[start]:
            start += 1
            continue

        label = labels.iloc[start]
        end = start + 1

        while (
            end < len(df)
            and valid.iloc[end]
            and labels.iloc[end] == label
        ):
            end += 1

        segment = df.iloc[start:end][SENSOR_COLS].to_numpy(
            dtype=np.float32
        )

        # Drop windows containing non-finite sensor readings.
        for i in range(0, len(segment) - WINDOW_SIZE + 1, STRIDE):
            window = segment[i:i + WINDOW_SIZE]

            if np.isfinite(window).all():
                X.append(window)
                y.append(str(label).strip())

        start = end

    return X, y

for path in train_files:
    df = pd.read_csv(path, low_memory=False, dtype={"label": "string"})

    # Ensure sensor columns are numeric.
    df[SENSOR_COLS] = df[SENSOR_COLS].apply(
        pd.to_numeric, errors="coerce"
    )

    X_file, y_file = make_windows(df)

    # Hold out entire participants for validation.
    pid = participant_id(path)

    if pid in (20, 21):
        X_val_raw.extend(X_file)
        y_val_raw.extend(y_file)
    else:
        X_train_raw.extend(X_file)
        y_train_raw.extend(y_file)

    print(
        os.path.basename(path),
        "| windows:", len(X_file),
        "| split:", "validation" if pid in (20, 21) else "training"
    )

X_train_raw = np.asarray(X_train_raw, dtype=np.float32)
X_val_raw = np.asarray(X_val_raw, dtype=np.float32)
y_train_raw = np.asarray(y_train_raw, dtype=str)
y_val_raw = np.asarray(y_val_raw, dtype=str)

print("\nTraining windows:", X_train_raw.shape)
print("Validation windows:", X_val_raw.shape)
print("Training classes:", len(np.unique(y_train_raw)))
print("Validation classes:", len(np.unique(y_val_raw)))



from sklearn.preprocessing import StandardScaler, LabelEncoder

scaler = StandardScaler()

# Fit on training sensor readings only.
X_train_2d = X_train_raw.reshape(-1, len(SENSOR_COLS))
scaler.fit(X_train_2d)

X_train = scaler.transform(X_train_2d).reshape(X_train_raw.shape)
X_val = scaler.transform(
    X_val_raw.reshape(-1, len(SENSOR_COLS))
).reshape(X_val_raw.shape)

encoder = LabelEncoder()
y_train = encoder.fit_transform(y_train_raw)

# Unknown validation classes should be checked, not silently encoded.
unknown = sorted(set(y_val_raw) - set(encoder.classes_))
print("Validation labels unseen in training:", unknown)

val_mask = np.isin(y_val_raw, encoder.classes_)
X_val = X_val[val_mask]
y_val_raw = y_val_raw[val_mask]
y_val = encoder.transform(y_val_raw)

NUM_CLASSES = len(encoder.classes_)

print("Classes:", list(encoder.classes_))
print("X_train:", X_train.shape)
print("X_val:", X_val.shape)



import tensorflow as tf
from tensorflow.keras import layers, models, callbacks

tf.keras.utils.set_random_seed(42)

model = models.Sequential([
    layers.Input(shape=(WINDOW_SIZE, len(SENSOR_COLS))),

    layers.Conv1D(64, kernel_size=5, padding="same", activation="relu"),
    layers.BatchNormalization(),
    layers.MaxPooling1D(pool_size=2),
    layers.Dropout(0.25),

    layers.Conv1D(128, kernel_size=3, padding="same", activation="relu"),
    layers.BatchNormalization(),
    layers.MaxPooling1D(pool_size=2),
    layers.Dropout(0.25),

    layers.GlobalAveragePooling1D(),
    layers.Dense(64, activation="relu"),
    layers.Dropout(0.3),
    layers.Dense(NUM_CLASSES, activation="softmax")
])

model.compile(
    optimizer=tf.keras.optimizers.Adam(learning_rate=1e-3),
    loss="sparse_categorical_crossentropy",
    metrics=["accuracy"]
)

model.summary()

early_stop = callbacks.EarlyStopping(
    monitor="val_loss",
    patience=3,
    restore_best_weights=True
)

history = model.fit(
    X_train,
    y_train,
    validation_data=(X_val, y_val),
    epochs=15,
    batch_size=256,
    callbacks=[early_stop],
    verbose=1
)



from sklearn.metrics import (
    accuracy_score, precision_score, recall_score, f1_score,
    classification_report
)

probabilities = model.predict(X_val, batch_size=512)
predictions = probabilities.argmax(axis=1)

print("Validation Accuracy:", round(accuracy_score(y_val, predictions), 4))
print("Macro Precision:", round(precision_score(
    y_val, predictions, average="macro", zero_division=0), 4))
print("Macro Recall:", round(recall_score(
    y_val, predictions, average="macro", zero_division=0), 4))
print("Macro F1:", round(f1_score(
    y_val, predictions, average="macro", zero_division=0), 4))

print(classification_report(
    y_val, predictions,
    labels=range(NUM_CLASSES),
    target_names=encoder.classes_,
    zero_division=0
))



model.save("/kaggle/working/wear_1d_cnn.keras")

import pandas as pd

results = pd.DataFrame([{
    "model": "1D-CNN",
    "validation_accuracy": accuracy_score(y_val, predictions),
    "macro_precision": precision_score(
        y_val, predictions, average="macro", zero_division=0),
    "macro_recall": recall_score(
        y_val, predictions, average="macro", zero_division=0),
    "macro_f1": f1_score(
        y_val, predictions, average="macro", zero_division=0)
}])

results.to_csv("/kaggle/working/cnn_results.csv", index=False)
print(results)
