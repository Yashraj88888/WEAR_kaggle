class CachedWindowDataset(Dataset):
    """CNN dataset backed by precomputed normalized sensor windows."""
    def __init__(self, windows_path, index_df):
        self.X = np.load(windows_path, mmap_mode="r")
        self.locations = index_df["location_id"].to_numpy(dtype=np.int64, copy=True)
        self.labels = index_df["label_id"].to_numpy(dtype=np.int64, copy=True)
        if len(self.X) != len(index_df):
            raise ValueError(f"Window cache length {len(self.X)} != index length {len(index_df)}")

    def __len__(self):
        return len(self.labels)

    def __getitem__(self, idx):
        # Copy one mmap slice to writable memory before wrapping as a tensor.
        sensor = np.array(self.X[idx], dtype=np.float32, copy=True)
        return {
            "sensor": torch.from_numpy(sensor),
            "location": torch.tensor(self.locations[idx], dtype=torch.long),
            "label": torch.tensor(self.labels[idx], dtype=torch.long),
        }


def materialize_sensor_windows(index_df, output_path, chunk_note=""):
    """Precompute exactly the indexed 50x3 sensor windows, without video I/O."""
    if os.path.exists(output_path):
        os.remove(output_path)

    windows = np.lib.format.open_memmap(
        output_path, mode="w+", dtype=np.float32,
        shape=(len(index_df), SENSOR_WINDOW, 3)
    )
    time_offsets = np.arange(SENSOR_WINDOW, dtype=np.int64)[None, :]
    col_index = {c: i for i, c in enumerate(sensor_columns)}
    group_positions = index_df.groupby("sensor_path", sort=False).indices

    for rec_num, (path, positions) in enumerate(group_positions.items(), start=1):
        # Read only numeric accelerometer columns; text labels never enter float conversion.
        frame = pd.read_csv(path, usecols=sensor_columns)
        frame = frame[sensor_columns]  # enforce canonical sensor_columns order
        raw = frame.to_numpy(dtype=np.float32, copy=True)
        row_locations = index_df.iloc[positions]["sensor_location"].to_numpy()

        for location in pd.unique(row_locations):
            pos_loc = np.asarray(positions)[row_locations == location]
            starts = index_df.iloc[pos_loc]["start"].to_numpy(dtype=np.int64)
            channels = SENSOR_MAPPINGS[location]
            channel_ids = [col_index[c] for c in channels]
            location_raw = raw[:, channel_ids]
            take = starts[:, None] + time_offsets
            batch_windows = location_raw[take].copy()

            # Preserve the notebook's NaN/Inf sanitization before and after normalization.
            batch_windows = np.nan_to_num(batch_windows, nan=0.0, posinf=0.0, neginf=0.0)
            mean = sensor_mean[channel_ids]
            std = sensor_std[channel_ids]
            batch_windows = (batch_windows - mean) / std
            batch_windows = np.nan_to_num(batch_windows, nan=0.0, posinf=0.0, neginf=0.0)
            windows[pos_loc] = batch_windows

        if rec_num % 10 == 0 or rec_num == len(group_positions):
            print(f"{chunk_note} recordings cached: {rec_num}/{len(group_positions)}")

    windows.flush()
    del windows
    print(f"Saved {len(index_df):,} windows to {output_path}")



