class Wear1DCNN(nn.Module):
    def __init__(self, num_classes=19, num_locations=4, location_dim=16, dropout=0.25):
        super().__init__()

        self.conv_block1 = nn.Sequential(
            nn.Conv1d(3, 64, kernel_size=5, padding=2),
            nn.BatchNorm1d(64),
            nn.ReLU(inplace=True),
            nn.MaxPool1d(kernel_size=2),
            nn.Dropout(dropout),
        )

        self.conv_block2 = nn.Sequential(
            nn.Conv1d(64, 128, kernel_size=3, padding=1),
            nn.BatchNorm1d(128),
            nn.ReLU(inplace=True),
            nn.MaxPool1d(kernel_size=2),
            nn.Dropout(dropout),
        )

        self.global_pool = nn.AdaptiveAvgPool1d(1)
        self.location_embedding = nn.Embedding(num_locations, location_dim)

        self.classifier = nn.Sequential(
            nn.Linear(128 + location_dim, 64),
            nn.ReLU(inplace=True),
            nn.Dropout(0.3),
            nn.Linear(64, num_classes),
        )

    def forward(self, sensor, location):
        # Shared pipeline returns [B, 50, 3]; Conv1d expects [B, 3, 50].
        x = sensor.transpose(1, 2)
        x = self.conv_block1(x)
        x = self.conv_block2(x)
        x = self.global_pool(x).squeeze(-1)

        loc = self.location_embedding(location)
        x = torch.cat([x, loc], dim=1)
        return self.classifier(x)


model = Wear1DCNN(num_classes=NUM_CLASSES).to(DEVICE)

total_params = sum(p.numel() for p in model.parameters() if p.requires_grad)
